{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-catalog-app",
  "main": "./src/server/entry-worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "<my-name>.daleel-al-suez.com/*",
      "zone_name": "daleel-al-suez.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
